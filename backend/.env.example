# Copy to .env and fill in for local development.
# Never commit a real .env file.

# Local development default: file-based SQLite, no separate database
# service needed.
DATABASE_URL=sqlite:///./tanfinet_pm.db

# Production (and anyone who prefers it locally) should use PostgreSQL
# instead - uncomment this and comment out the SQLite line above:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tanfinet_pm

# Google Drive upload (see backend/README.md, "Google Drive Upload",
# for how to obtain a service-account key). Leave GOOGLE_SERVICE_ACCOUNT_FILE
# unset to run with Drive upload disabled (NotConfiguredDriveUploadService) -
# every /visits/{id}/sync call then fails clearly instead of pretending
# to succeed. NEVER commit the actual key file this points at.
# GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/google-drive-service-account.json
# GOOGLE_DRIVE_ROOT_FOLDER_NAME=TANFINET PM Monitoring
# GOOGLE_DRIVE_PARENT_FOLDER_ID=
