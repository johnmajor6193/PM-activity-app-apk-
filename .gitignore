# ---- Flutter / Dart (mobile_app/) ----
mobile_app/.dart_tool/
mobile_app/.flutter-plugins
mobile_app/.flutter-plugins-dependencies
mobile_app/.packages
mobile_app/.pub-cache/
mobile_app/.pub/
mobile_app/build/
mobile_app/android/.gradle
mobile_app/android/local.properties
mobile_app/android/key.properties
mobile_app/android/app/*.jks
mobile_app/android/app/*.keystore
mobile_app/ios/Flutter/.last_build_id
mobile_app/ios/Pods/
mobile_app/*.iml
mobile_app/*.g.dart
mobile_app/*.freezed.dart

# ---- Python / FastAPI (backend/) ----
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/.venv/
backend/venv/
backend/env/
backend/.pytest_cache/
backend/.mypy_cache/
backend/*.egg-info/

# ---- Secrets / environment ----
.env
*.env.local
**/service-account*.json
**/google-drive-credentials*.json
# Conventional local drop location for the Google Drive service-account
# key file (see backend/.env.example, GOOGLE_SERVICE_ACCOUNT_FILE) -
# the whole directory is ignored, not just specific filenames, so any
# key file placed here is protected regardless of what it's named.
backend/credentials/

# ---- IDE / OS ----
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# ---- Logs ----
*.log
